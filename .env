# Copy this file to client/.env
#
# Optional: your deployed Google Apps Script Web App URL (ends in /exec).
# When set, the frontend reads the product catalog directly from the sheet
# via Apps Script and does NOT need the Express server at all.
#
# Leave this blank/unset to use the Express backend in /server instead.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbw4jBzF-m7i1Y_A6LX4-LfW474Rl89pm90aFsGbtADYFb8wF7AO_6-WogPpbtEyOM4QRQ/exec